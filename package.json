{
  "name": "prometheux-chain-ts-examples",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "inline": "tsx --env-file-if-exists=.env src/01-evaluate-inline.ts",
    "file": "tsx --env-file-if-exists=.env src/02-evaluate-file.ts",
    "params": "tsx --env-file-if-exists=.env src/03-evaluate-with-params.ts",
    "check": "tsx --env-file-if-exists=.env src/04-check-programs.ts",
    "your-data": "tsx --env-file-if-exists=.env src/05-evaluate-with-your-data.ts",
    "concepts": "tsx --env-file-if-exists=.env src/06-concepts.ts",
    "playground": "tsx --env-file-if-exists=.env src/07-playground.ts",
    "browser": "node --env-file-if-exists=.env browser/serve.mjs",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts",
    "typecheck": "tsc && tsc -p browser"
  },
  "dependencies": {
    "@pmtx/chain": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
